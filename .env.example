# pilight configuration. Lights live in the file named by PILIGHT_LIGHTS.
PILIGHT_HOST=127.0.0.1
PILIGHT_PORT=3300
# Write calls (PUT) need this key. Unset = open (development only).
PILIGHT_API_KEY=
# manual | atem | encoder | youtube
PILIGHT_MODE=manual
PILIGHT_LIGHTS=config/lights.json
# pigateway (the only device service pilight talks to)
PILIGHT_GATEWAY_URL=http://127.0.0.1:3100
PILIGHT_GATEWAY_API_KEY=
PILIGHT_POLL_MS=3000
PILIGHT_GATEWAY_TIMEOUT_MS=3000
# After this long without an answer from pigateway the auto modes show UNKNOWN
PILIGHT_STALE_MS=15000
