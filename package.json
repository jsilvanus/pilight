{
  "name": "pilight",
  "version": "0.1.0",
  "description": "Tally light controller service and CLI for Tally-Ma wireless tally lights over UDP, HTTP, and Cloud/MQTT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test tests/**/*.test.ts",
    "cli": "tsx src/cli.ts"
  },
  "bin": {
    "pilight": "bin/pilight.mjs"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "mqtt": "^5.10.3",
    "multicast-dns": "^7.2.5"
  },
  "devDependencies": {
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  },
  "files": [
    "dist",
    "bin"
  ]
}
