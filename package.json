{
  "name": "pitally",
  "version": "0.1.0",
  "description": "Tally light controller service and CLI for Tally-Ma wireless tally lights over UDP, HTTP, and Cloud/MQTT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test tests/**/*.test.ts",
    "cli": "tsx src/cli.ts"
  },
  "bin": {
    "pitally": "bin/pitally.mjs"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "mqtt": "^5.10.3",
    "multicast-dns": "^7.2.5"
  },
  "devDependencies": {
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.0"
  },
  "files": [
    "dist",
    "bin"
  ],
  "pi": {
    "service": "pitally",
    "displayName": "PiTally",
    "layer": "Layer 1: Southbound hardware",
    "port": 3107,
    "ports": {},
    "healthEndpoint": "/health",
    "envPortVar": "PITALLY_PORT"
  }
}
